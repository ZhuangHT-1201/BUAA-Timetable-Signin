{
  "name": "buaa-timetable-signin",
  "version": "0.2.0",
  "private": true,
  "description": "BUAA timetable and classroom sign-in for Windows and Android",
  "author": "Huiteng Zhuang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZhuangHT-1201/BUAA-Timetable-Signin.git"
  },
  "bugs": {
    "url": "https://github.com/ZhuangHT-1201/BUAA-Timetable-Signin/issues"
  },
  "homepage": "https://github.com/ZhuangHT-1201/BUAA-Timetable-Signin",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:desktop": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:web": "tsc -b && vite build",
    "build:desktop": "npm run build:web && electron-builder --win --x64",
    "build:android": "npm run build:web && cap sync android && cd android && gradlew.bat assembleDebug",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "screenshots": "electron scripts/capture-screenshots.cjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "crypto-js": "^4.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "sharp": "^0.35.5",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.0.5",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "io.github.zhuanght1201.buaatimetablesign",
    "productName": "BUAA Timetable & Sign-in",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "resources/icon.png",
      "package.json",
      "!node_modules/**/*"
    ],
    "npmRebuild": false,
    "win": {
      "icon": "resources/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "BUAA-Timetable-Signin-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BUAA Timetable & Sign-in",
      "unicode": true
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true
  }
}
